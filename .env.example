# Telegram credentials are intentionally blank until the dedicated monitoring account is ready.
# Never commit the real values or a .session file.
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/telegram_leads
# Comma-separated public Telegram usernames/links that you are authorized to monitor.
TG_SOURCES=

# Zoho Mail business-domain SMTP defaults for lawlegal.de.
# Use the exact server shown in your Zoho Mail Admin/Account settings if Zoho
# assigns a region-specific endpoint to your organization.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
SMTP_USER=info@lawlegal500.de
SMTP_PASSWORD=EEzCTzMLBffP
MAIL_FROM=info@lawlegal500.de
MAIL_TO=info@lawlegal500.de
SMTP_USE_TLS=true

DB_PATH=data/leads.sqlite3
# Keep true until the first test cycle has been reviewed by a human.
DRY_RUN=true
MIN_EMAIL_SCORE=50
HOT_SCORE=80
# Conservative polling: do not reduce below 60 seconds.
POLL_SECONDS=900
# Legacy search-depth setting; production mode should prefer configured sources.
SEARCH_LIMIT=25
COMMENTS_LIMIT=5
COMMENTS_ACTIVE_DAYS=30
# Maximum recent posts inspected per configured source per cycle.
MESSAGES_PER_SOURCE=50
# Maximum posts per source for which discussion comments are inspected per cycle.
COMMENT_POSTS_PER_SOURCE=5
# Minimum delay between Telegram read operations.
REQUEST_DELAY_SECONDS=3
# Random extra delay added to read operations.
JITTER_SECONDS=2
