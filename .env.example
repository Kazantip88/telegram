# Telegram credentials are intentionally blank until the dedicated monitoring account is ready.
# Never commit the real values or a .session file.
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/telegram_leads
# Comma-separated public Telegram usernames/links that you are authorized to monitor.
TG_SOURCES=
# Use built-in RU/DE/EN/NL first-person help-request queries by default.
USE_CUSTOM_TG_SEARCH_QUERIES=false
TG_SEARCH_QUERIES=

# X official API (Bearer Token from the X Developer Console). Keep the token secret.
# X collection requires a working X API project/app and available pay-per-use credits.
X_ENABLED=true
X_API_BEARER_TOKEN=
# Defaults search for direct help requests in RU/DE/EN/NL. Custom queries are optional, separated by |.
X_SEARCH_QUERIES=
# X recent-search requires 10-100 results per query. Keep low to control cost.
X_MAX_RESULTS=10
# Default: one search cycle every 6 hours. Results are incremental via since_id.
X_POLL_SECONDS=21600
X_TIMEOUT_SECONDS=20

# Zoho Mail business-domain SMTP defaults for lawlegal.de.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
SMTP_USER=info@lawlegal500.de
SMTP_PASSWORD=
MAIL_FROM=info@lawlegal500.de
MAIL_TO=info@lawlegal500.de
SMTP_USE_TLS=true

# Public RSS/Atom feeds: comma-separated URLs. Read-only; no login or bypass.
RSS_FEEDS=
RSS_MAX_ITEMS=50
RSS_TIMEOUT_SECONDS=20
RSS_REQUEST_DELAY_SECONDS=2

# Public Reddit search RSS is enabled by default. Optional comma-separated public RSS/Atom forum or Q&A feeds:
# COMMUNITY_FEEDS=https://example.org/public-forum.rss

# Facebook search-engine scraping is disabled and is not part of the active pipeline.
FACEBOOK_ENABLED=false
FACEBOOK_QUERIES=
FACEBOOK_MAX_ITEMS=50

DB_PATH=data/leads.sqlite3
DRY_RUN=true
MIN_EMAIL_SCORE=50
HOT_SCORE=80
POLL_SECONDS=900
SEARCH_LIMIT=25
COMMENTS_LIMIT=5
COMMENTS_ACTIVE_DAYS=30
MESSAGES_PER_SOURCE=50
COMMENT_POSTS_PER_SOURCE=5
REQUEST_DELAY_SECONDS=3
JITTER_SECONDS=2
