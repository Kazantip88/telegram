TG_API_ID=
TG_API_HASH=
TG_SESSION=telegram_leads
# Comma-separated public Telegram usernames/links that you are authorized to monitor.
TG_SOURCES=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=info@lawlegal500.de
SMTP_USE_TLS=true

DB_PATH=data/leads.sqlite3
DRY_RUN=true
MIN_EMAIL_SCORE=50
HOT_SCORE=80
# How often the monitoring cycle runs, in seconds.
POLL_SECONDS=300
# Search depth per Telegram query.
SEARCH_LIMIT=100
# Maximum recent comments to inspect for a post that has comments.
COMMENTS_LIMIT=10
# A discussion is considered active if it has a readable comment within this many days.
COMMENTS_ACTIVE_DAYS=30
